{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/phac-nml/metadatatransformation/main/assets/schema_output.json",
    "title": "Metadata Transformation Output Schema",
    "description": "The metadatatransformation-specific schema used for validating IRIDA Next JSON output data",
    "type": "object",
    "properties": {
        "files": {
            "type": "object",
            "properties": {
                "global": {
                    "type": "array",
                    "items": {
                        "properties": {
                            "path": {
                                "anyOf": [
                                    {
                                        "pattern": "^.*transformation/.*results.csv$",
                                        "description": "The results of the metadata transformation in CSV format."
                                    }
                                ]
                            }
                        },
                        "additionalProperties": false
                    },
                    "uniqueItems": true
                },
                "samples": {
                    "type": "object",
                    "patternProperties": {
                        "^.*$": {
                            "type": "array",
                            "items": {
                                "properties": {},
                                "additionalProperties": false
                            },
                            "uniqueItems": true
                        }
                    }
                }
            }
        },
        "metadata": {
            "type": "object",
            "properties": {
                "samples": {
                    "type": "object",
                    "patternProperties": {
                        "^.*$": {
                            "type": "object",
                            "properties": {}
                        }
                    }
                }
            }
        }
    }
}
